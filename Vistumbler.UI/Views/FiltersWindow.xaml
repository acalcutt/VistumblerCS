<Window x:Class="Vistumbler.UI.Views.FiltersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Filters" Width="900" Height="640" MinWidth="760" MinHeight="560"
        WindowStartupLocation="CenterOwner">

    <!-- The original Vistumbler's Add/Remove Filters and Add/Edit Filter windows, side by side -->
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- The saved filters -->
        <DockPanel Grid.Column="0" Grid.Row="0">
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                <Button Content="Add Filter" Width="90" Click="Add_Click"/>
                <Button x:Name="DeleteButton" Content="Delete Filter" Width="90" Margin="6,0,0,0" Click="Delete_Click" IsEnabled="False"/>
            </StackPanel>
            <ListView x:Name="FilterList" SelectionMode="Single" SelectionChanged="FilterList_SelectionChanged">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="ID" Width="40" DisplayMemberBinding="{Binding FiltId}"/>
                        <GridViewColumn Header="Name" Width="200" DisplayMemberBinding="{Binding FiltName}"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </DockPanel>

        <!-- The one being edited -->
        <ScrollViewer Grid.Column="2" Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="Editor" IsEnabled="False">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Filter Name"/>
                        <TextBox Text="{Binding FiltName, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Filter Description"/>
                        <TextBox Text="{Binding FiltDesc, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>

                <GroupBox Header="Filters" Margin="0,10,0,0" Padding="8">
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,8" Foreground="DimGray">
                            An AP is shown only when it passes every field. * means any.
                            A list is <Run FontFamily="Consolas">1,6,11</Run>, a range <Run FontFamily="Consolas">1-6</Run>
                            or <Run FontFamily="Consolas">-80--60</Run>, not is <Run FontFamily="Consolas">&lt;&gt;6</Run>
                            (in a list too: <Run FontFamily="Consolas">&lt;&gt;6,&lt;&gt;11</Run>), and % is any text
                            (<Run FontFamily="Consolas">Linksys%</Run>, <Run FontFamily="Consolas">%guest%</Run>).
                            For a comma, dash or percent in the text itself, put \ before it.
                        </TextBlock>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="SSID"/>
                                <TextBox Text="{Binding Ssid, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"/>
                                <TextBlock Text="Mac Address"/>
                                <TextBox Text="{Binding Bssid, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"/>
                                <TextBlock Text="Channel"/>
                                <TextBox Text="{Binding Channel, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"/>
                                <TextBlock Text="Authentication (e.g. WPA2-Personal)"/>
                                <TextBox Text="{Binding Auth, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"/>
                                <TextBlock Text="Encryption (e.g. CCMP)"/>
                                <TextBox Text="{Binding Encr, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"/>
                                <TextBlock Text="Radio Type"/>
                                <TextBox Text="{Binding RadType, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"/>
                                <TextBlock Text="Network Type (Infrastructure, Ad Hoc)"/>
                                <TextBox Text="{Binding NetType, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Active (1 active, 0 dead)"/>
                                <TextBox Text="{Binding Active, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"/>
                                <TextBlock Text="Signal (%)"/>
                                <TextBox Text="{Binding Signal, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"/>
                                <TextBlock Text="High Signal (%)"/>
                                <TextBox Text="{Binding HighSig, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"/>
                                <TextBlock Text="RSSI (dBm)"/>
                                <TextBox Text="{Binding Rssi, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"/>
                                <TextBlock Text="High RSSI (dBm)"/>
                                <TextBox Text="{Binding HighRssi, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"/>
                                <TextBlock Text="Basic Transfer Rates"/>
                                <TextBox Text="{Binding Btx, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"/>
                                <TextBlock Text="Other Transfer Rates"/>
                                <TextBox Text="{Binding Otx, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                    <TextBlock x:Name="SavedText" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="DarkGreen"/>
                    <Button Content="Save Filter" Width="100" Click="Save_Click"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Button Grid.Column="2" Grid.Row="1" Content="Close" Width="90" HorizontalAlignment="Right" Margin="0,10,0,0"
                IsCancel="True" Click="Close_Click"/>
    </Grid>
</Window>
