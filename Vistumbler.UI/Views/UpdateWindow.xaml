<Window x:Class="Vistumbler.UI.Views.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Update Available" Width="560" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Closing="Window_Closing">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeadingText" Grid.Row="0" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <TextBlock x:Name="VersionText" Grid.Row="1" Margin="0,4,0,10" TextWrapping="Wrap"/>

        <TextBlock Grid.Row="2" Text="Release notes" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <TextBox   x:Name="NotesBox" Grid.Row="3" Height="220" IsReadOnly="True" TextWrapping="Wrap"
                   VerticalScrollBarVisibility="Auto" Padding="4,3"/>

        <TextBlock x:Name="InfoText" Grid.Row="4" Margin="0,10,0,0" TextWrapping="Wrap"/>

        <StackPanel x:Name="ProgressPanel" Grid.Row="5" Margin="0,10,0,0" Visibility="Collapsed">
            <TextBlock   x:Name="StatusText" TextWrapping="Wrap" Margin="0,0,0,4"/>
            <ProgressBar x:Name="DownloadProgress" Height="14" Maximum="1"/>
        </StackPanel>

        <DockPanel Grid.Row="6" Margin="0,14,0,0" LastChildFill="False">
            <Button x:Name="ReleasePageButton" DockPanel.Dock="Left" Content="Release Page" MinWidth="100"
                    Padding="10,2" Click="ReleasePage_Click"/>
            <Button x:Name="LaterButton" DockPanel.Dock="Right" Content="Later" MinWidth="80" Padding="10,2"
                    IsCancel="True" Click="Later_Click"/>
            <Button x:Name="PrimaryButton" DockPanel.Dock="Right" MinWidth="130" Padding="10,2" Margin="0,0,8,0"
                    IsDefault="True" Click="Primary_Click"/>
        </DockPanel>
    </Grid>
</Window>
